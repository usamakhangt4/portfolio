---
import { getCollection } from "astro:content";
import BaseLayout from "@/layouts/BaseLayout.astro";
import ProjectCard from "@/components/ProjectCard.astro";
import SiteFooter from "@/components/SiteFooter.astro";
import SiteHeader from "@/components/SiteHeader.astro";
import { profilePageJsonLd } from "@/lib/seo";
import {
  careerHighlights,
  earlierProfessionalProjects,
  education,
  experience,
  siteConfig,
  stackGroups,
} from "@/data/site";

const work = (await getCollection("work"))
  .filter((project) => !project.data.draft && project.data.featured)
  .sort((a, b) => a.data.order - b.data.order);

const companyWork = work.filter((project) => project.data.kind === "company");
const publicWork = work.filter((project) => project.data.kind !== "company");

const flagshipWork = publicWork.filter(
  (project) => (project.data.tier ?? "flagship") === "flagship",
);
const supportingWork = publicWork.filter(
  (project) => project.data.tier === "supporting",
);

const featuredIds = [
  "corpo-braindance",
  "yolopv2-studio",
  "kitten-tts-webui",
  "shadcn-virtualized-tree",
] as const;
const featuredProjects = featuredIds.flatMap((id) => {
  const project = flagshipWork.find((item) => item.id === id);
  return project ? [project] : [];
});

function liveDemo(links: { label: string; href: string }[]) {
  return links.find((link) => link.label.toLowerCase().includes("live")) ?? null;
}
---

<BaseLayout canonicalPath="/" jsonLd={profilePageJsonLd()}>
  <SiteHeader />

  <main id="main-content" tabindex="-1">
    <section class="hero">
      <div class="section-shell">
        <div class="hero-inner">
          <p class="hero-role mono">{siteConfig.role}</p>
          <h1>{siteConfig.name}</h1>
          <p class="hero-lede">{siteConfig.lede}</p>
          <p class="hero-location mono">
            {siteConfig.location} / {siteConfig.availability}
          </p>
          <div class="hero-actions">
            <a class="button button-primary" href="/work">View work</a>
            <a
              class="button"
              href={siteConfig.resume}
              target="_blank"
              rel="noopener noreferrer"
            >Resume</a>
            <a
              class="button button-text"
              href={siteConfig.social.linkedin}
              target="_blank"
              rel="noopener noreferrer"
            >LinkedIn ↗</a>
            <a
              class="button button-text"
              href={siteConfig.social.github}
              target="_blank"
              rel="noopener noreferrer"
            >GitHub ↗</a>
          </div>
        </div>

        {
          featuredProjects.length > 0 && (
            <div class="hero-features">
              <p class="hero-feature-label mono">Featured</p>
              <div class="hero-feature-grid">
                {featuredProjects.map((project) => {
                  const demo = liveDemo(project.data.links);
                  return (
                    <article class="hero-feature">
                      <div class="hero-feature-frame">
                        <div class="preview-chrome" aria-hidden="true">
                          <span></span><span></span><span></span>
                          <code class="mono">{project.id}</code>
                        </div>
                        <div class="hero-feature-body">
                          <p class="mono">{project.data.type}</p>
                          <a class="hero-feature-title" href={`/work/${project.id}`}>
                            {project.data.title}
                          </a>
                          <p>{project.data.summary}</p>
                          {
                            demo && (
                              <div class="hero-feature-actions">
                                <a
                                  class="button"
                                  href={demo.href}
                                  target="_blank"
                                  rel="noopener noreferrer"
                                >
                                  Live demo
                                </a>
                              </div>
                            )
                          }
                        </div>
                      </div>
                    </article>
                  );
                })}
              </div>
            </div>
          )
        }
      </div>
    </section>

    <section class="section-shell career-highlights" aria-label="Career highlights">
      {careerHighlights.map((item) => (
        <div class="career-highlight">
          <strong>{item.value}</strong>
          <span>{item.label}</span>
        </div>
      ))}
    </section>

    <section id="experience" class="section-shell section-block experience-section">
      <div class="section-heading section-heading-wide">
        <p class="section-kicker mono">Professional experience</p>
        <h2>7+ years of software engineering</h2>
        <p>Frontend-led product work, backed by full-stack and applied AI systems.</p>
      </div>

      <div class="experience-list">
        {experience.map((item, index) => (
          <article class="experience-item">
            <div class="experience-meta">
              <span class="experience-index mono">
                {String(index + 1).padStart(2, "0")}
              </span>
              <span class="mono">{item.period}</span>
              <span>{item.location}</span>
            </div>
            <div class="experience-content">
              <h3>{item.role}</h3>
              <p class="experience-company">{item.company}</p>
              <p>{item.summary}</p>
              <ul>
                {item.highlights.map((highlight) => <li>{highlight}</li>)}
              </ul>
            </div>
          </article>
        ))}
      </div>
    </section>

    <section id="professional-work" class="section-shell section-block professional-work-section">
      <div class="section-heading section-heading-wide">
        <p class="section-kicker mono">Professional work</p>
        <h2>Company systems</h2>
        <p>Client products since 2024, then earlier interface-heavy products.</p>
      </div>

      <div class="professional-project-grid">
        {companyWork.map((project, index) => (
          <article class="professional-project-card">
            <div class="professional-project-heading">
              <span class="mono">{String(index + 1).padStart(2, "0")}</span>
              <span class="mono">{project.data.type}</span>
            </div>
            <h3>{project.data.title}</h3>
            <p>{project.data.summary}</p>
            <ul aria-label={`${project.data.title} stack`}>
              {project.data.stack.map((item) => <li class="mono">{item}</li>)}
            </ul>
            <a class="professional-project-more mono" href={`/work/${project.id}`}>
              Case study
            </a>
          </article>
        ))}
        {earlierProfessionalProjects.map((project, index) => (
          <article class="professional-project-card">
            <div class="professional-project-heading">
              <span class="mono">
                {String(companyWork.length + index + 1).padStart(2, "0")}
              </span>
              <span class="mono">{project.type}</span>
            </div>
            <h3>{project.title}</h3>
            <p>{project.description}</p>
            <ul aria-label={`${project.title} stack`}>
              {project.stack.map((item) => <li class="mono">{item}</li>)}
            </ul>
          </article>
        ))}
      </div>
    </section>

    <section id="work" class="section-shell section-block">
      <div class="section-heading section-heading-wide">
        <p class="section-kicker mono">Open source & independent work</p>
        <h2>Open-source libraries and tools</h2>
        <p>
          Published npm packages, developer tools, and local AI apps with public
          source, packages, or live demos.
        </p>
      </div>

      <div class="project-list">
        {flagshipWork.map((project, index) => (
          <ProjectCard project={project} index={index} />
        ))}
      </div>
    </section>

    <section id="stack" class="section-shell stack-section">
      <div class="stack-overview">
        <div class="stack-title-block">
          <p class="stack-eyebrow mono">Technical foundation</p>
          <h2>Stack</h2>
        </div>
        <p class="stack-summary">
          Frontend first, with the backend, applied AI, mobile, and delivery
          skills behind the products.
        </p>
      </div>

      <div class="stack-grid">
        {stackGroups.map((group, index) => (
          <article class="stack-card">
            <div class="stack-card-heading">
              <span class="stack-card-index mono">
                {String(index + 1).padStart(2, "0")}
              </span>
              <h3>{group.title}</h3>
            </div>
            <p>{group.description}</p>
            <ul aria-label={`${group.title} technologies`}>
              {group.items.map((item) => <li class="mono">{item}</li>)}
            </ul>
          </article>
        ))}
      </div>
    </section>

    {
      supportingWork.length > 0 && (
        <section id="more-work" class="section-shell section-block">
          <div class="section-heading">
            <h2>Also</h2>
            <p>Supporting apps and experiments.</p>
          </div>

          <div class="project-list project-list-compact">
            {supportingWork.map((project, index) => (
              <ProjectCard project={project} index={index} />
            ))}
          </div>
        </section>
      )
    }

    <section class="section-shell education-section" aria-labelledby="education-title">
      <div>
        <p class="section-kicker mono">Education</p>
        <h2 id="education-title">{education.degree}</h2>
        <p>{education.school}</p>
      </div>
      <span class="education-period mono">{education.period}</span>
    </section>
  </main>

  <SiteFooter />
</BaseLayout>
