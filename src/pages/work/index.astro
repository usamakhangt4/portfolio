---
import { getCollection } from "astro:content";
import BaseLayout from "@/layouts/BaseLayout.astro";
import ProjectCard from "@/components/ProjectCard.astro";
import SiteFooter from "@/components/SiteFooter.astro";
import SiteHeader from "@/components/SiteHeader.astro";

const projects = (await getCollection("work"))
  .filter((project) => !project.data.draft)
  .sort((a, b) => a.data.order - b.data.order);

const companyWork = projects.filter((project) => project.data.kind === "company");
const publicProjects = projects.filter((project) => project.data.kind !== "company");
const flagshipWork = publicProjects.filter(
  (project) => (project.data.tier ?? "flagship") === "flagship",
);
const supportingWork = publicProjects.filter(
  (project) => project.data.tier === "supporting",
);
---

<BaseLayout
  title="Work"
  description="Case studies from Muhammad Usama Khan — applied AI systems, full-stack products, and public computer-vision and frontend tools."
  canonicalPath="/work"
>
  <SiteHeader />

  <main id="main-content" tabindex="-1">
    <section class="section-shell work-page-intro">
      <h1>Work</h1>
      <p>
        Company systems first, then public libraries and tools. Supporting
        projects follow.
      </p>
    </section>

    {
      companyWork.length > 0 && (
        <section class="section-shell section-block">
          <div class="section-heading">
            <h2>Company work</h2>
            <p>Applied AI and full-stack systems.</p>
          </div>
          <div class="project-list">
            {companyWork.map((project, index) => (
              <ProjectCard project={project} index={index} />
            ))}
          </div>
        </section>
      )
    }

    <section class="section-shell section-block">
      <div class="section-heading">
        <h2>Public work</h2>
        <p>Libraries and tools with source, packages, or samples.</p>
      </div>
      <div class="project-list">
        {flagshipWork.map((project, index) => (
          <ProjectCard project={project} index={index} />
        ))}
      </div>
    </section>

    {
      supportingWork.length > 0 && (
        <section class="section-shell section-block">
          <div class="section-heading">
            <h2>Also</h2>
            <p>Supporting apps and experiments.</p>
          </div>

          <div class="project-list project-list-compact">
            {supportingWork.map((project, index) => (
              <ProjectCard project={project} index={index} />
            ))}
          </div>
        </section>
      )
    }
  </main>

  <SiteFooter />
</BaseLayout>
